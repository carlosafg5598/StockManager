@model StockManager.Models.Proveedor

@{
    ViewData["Title"] = "Editar Proveedor";
}

<h2 class="text-center mb-4">Editar Proveedor</h2>

<form asp-action="Edit" method="post" class="w-75 mx-auto">
    <input type="hidden" asp-for="IdProveedor" />

    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input asp-for="NombreProveedor" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Teléfono</label>
        <input asp-for="TelefonoProveedor" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="EmailProveedor" type="email" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Dirección</label>
        <input asp-for="DireccionProveedor" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
</form>

