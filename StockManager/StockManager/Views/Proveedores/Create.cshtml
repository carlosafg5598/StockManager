@model StockManager.Models.Proveedor

@{
    ViewData["Title"] = "Nuevo Proveedor";
}

<h2 class="text-center mb-4">Crear Nuevo Proveedor</h2>

<form asp-action="Create" method="post" class="w-75 mx-auto">
    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input asp-for="NombreProveedor" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Teléfono</label>
        <input asp-for="TelefonoProveedor" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="EmailProveedor" type="email" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Dirección</label>
        <input asp-for="DireccionProveedor" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Volver</a>
</form>
