@model List<(StockManager.Models.ApplicationUser Usuario, string Rol)>
@{
    Layout = "_Layout";
}

<h2 class="mb-4 text-center">Gestión de Usuarios</h2>

<form method="get" class="row g-3 align-items-end mb-4">
    <div class="col-md-3">
        <label>Estado</label>
        <select name="estado" class="form-select">
            <option value="">Todos</option>
            <option value="Activo" selected="@(ViewBag.EstadoSeleccionado == "Activo")">Activos</option>
            <option value="Inactivo" selected="@(ViewBag.EstadoSeleccionado == "Inactivo")">Inactivos</option>
        </select>
    </div>

    <div class="col-md-3">
        <label>Rol</label>
        <select name="rol" class="form-select">
            <option value="">Todos</option>
            @foreach (var rol in ViewBag.Roles)
            {
                <option value="@rol" selected="@(ViewBag.RolSeleccionado == rol)">@rol</option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100">Filtrar</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Email</th>
            <th>Nombre Completo</th>
            <th>Rol</th>
            <th>Teléfono</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.Usuario.Activo ? "" : "table-secondary")">
                <td>@item.Usuario.Email</td>
                <td>@item.Usuario.NombreCompleto</td>
                <td>@item.Rol</td>
                <td>@item.Usuario.PhoneNumber</td>
                <td>@(item.Usuario.Activo ? "Activo" : "Inactivo")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Usuario.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Usuario.Id" class="btn btn-danger btn-sm">Eliminar</a>

                    <form asp-action="ToggleActivo" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@item.Usuario.Id" />
                        @Html.AntiForgeryToken()
                        @if (item.Usuario.Activo)
                        {
                            <button type="submit" class="btn btn-secondary btn-sm">Desactivar</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-success btn-sm">Activar</button>
                        }
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<a href="/Usuarios/Create" class="btn btn-primary">Crear nuevo usuario</a>
