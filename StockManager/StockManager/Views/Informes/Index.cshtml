@{
    ViewData["Title"] = "Informes de Movimientos";
    Layout = "_Layout";
}

<h2 class="mb-4 text-center">Panel de Informes</h2>

<section>
    <h4 class="mb-3">Análisis de Movimientos</h4>

    <form method="get" class="row g-3 align-items-end mb-3">
        <div class="col-md-3">
            <label>Tipo de movimiento</label>
            <select name="tipoMovimiento" class="form-select">
                <option value="">Todos</option>
                <option value="Entrada" selected="@(Context.Request.Query["tipoMovimiento"] == "Entrada")">Entradas</option>
                <option value="Salida" selected="@(Context.Request.Query["tipoMovimiento"] == "Salida")">Salidas</option>
            </select>
        </div>

        <div class="col-md-3">
            <label>Desde</label>
            <input type="date" name="desde" value="@Context.Request.Query["desde"]" class="form-control" />
        </div>

        <div class="col-md-3">
            <label>Hasta</label>
            <input type="date" name="hasta" value="@Context.Request.Query["hasta"]" class="form-control" />
        </div>

        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100">Filtrar</button>
        </div>
    </form>

    @if (ViewBag.Movimientos != null && ViewBag.Movimientos.Count > 0)
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Producto</th>
                    <th>Tipo</th>
                    <th>Cantidad</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in ViewBag.Movimientos)
                {
                    <tr>
                        <td>@m.FechaMovimiento.ToShortDateString()</td>
                        <td>@m.Producto?.NombreProducto</td>
                        <td>@m.TipoMovimiento</td>
                        <td>@m.Cantidad</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-3 text-end">
            <a class="btn btn-danger"
               asp-action="ExportarPDF"
               asp-route-tipoMovimiento="@Context.Request.Query["tipoMovimiento"]"
               asp-route-desde="@Context.Request.Query["desde"]"
               asp-route-hasta="@Context.Request.Query["hasta"]">
                Exportar informe a PDF
            </a>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center mt-4">
            No hay movimientos que coincidan con los filtros.
        </div>
    }
</section>
