@{
    ViewData["Title"] = "Panel principal";
}

<div class="text-center mt-5">
    <h2>¡Bienvenido, @ViewBag.Nombre!</h2>


    <hr />

    @if (User.IsInRole("Empleado"))
    {
        <div class="mt-4">
            <a asp-controller="Movimientos" asp-action="Index" class="btn btn-primary m-2">Registrar Movimiento</a>
            <a asp-controller="Productos" asp-action="Index" class="btn btn-outline-secondary m-2">Ver Stock</a>
        </div>
    }

    @if (User.IsInRole("Administrador"))
    {
        <div class="mt-4">
            <a asp-controller="Productos" asp-action="Index" class="btn btn-primary m-2">Gestionar Productos</a>
            <a asp-controller="Proveedores" asp-action="Index" class="btn btn-primary m-2">Proveedores</a>
            <a asp-controller="Movimientos" asp-action="Index" class="btn btn-outline-primary m-2">Ver Movimientos</a>
            
        </div>
    }

    @if (User.IsInRole("Jefe"))
    {
        <div class="mt-4">
            <a asp-controller="Usuarios" asp-action="Index" class="btn btn-primary m-2">Gestión de Empleados</a>
            <a asp-controller="Productos" asp-action="Index" class="btn btn-outline-secondary m-2">Ver Productos</a>
            <a asp-controller="Proveedores" asp-action="Index" class="btn btn-outline-secondary m-2">Ver Proveedores</a>
        </div>
    }


</div>
