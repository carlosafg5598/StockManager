@{
    Layout = "_Layout";
}

<div class="container mt-5 text-center">
    <h2 class="mb-3">¡Bienvenido, @ViewBag.Nombre!</h2>
    <p class="text-muted">Resumen de los últimos movimientos registrados</p>
    <hr class="mb-5" />

    @if (Model != null)
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <h4 class="card-title text-center mb-4">Últimos 3 Movimientos</h4>
                <table class="table table-hover text-center">
                    <thead class="table-light">
                        <tr>
                            <th>Producto</th>
                            <th>Tipo de Movimiento</th>
                            <th>Cantidad</th>
                            <th>Fecha</th>
                            <th>Descripción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var mov in Model)
                        {
                            <tr>
                                <td>@mov.Producto?.NombreProducto</td>
                                <td>
                                    @if (mov.TipoMovimiento == "Entrada")
                                    {
                                        <span class="badge bg-success">Entrada</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Salida</span>
                                    }
                                </td>
                                <td>@mov.Cantidad</td>
                                <td>@mov.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@mov.Descripcion</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            No hay movimientos registrados aún.
        </div>
    }

</div>


 