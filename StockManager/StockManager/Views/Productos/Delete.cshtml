@model StockManager.Models.Producto
@{
    ViewData["Title"] = "Eliminar producto";
}

<h2 class="text-danger mb-4">Eliminar Producto</h2>

<div class="card p-4 shadow-sm">
    <div class="card-body">
        <p>¿Seguro que deseas eliminar este producto?</p>

        <ul class="list-group mb-4">
            <li class="list-group-item"><strong>Nombre:</strong> @Model.NombreProducto</li>
            <li class="list-group-item"><strong>Descripción:</strong> @Model.DescripcionProducto</li>
            <li class="list-group-item"><strong>Precio:</strong> @Model.PrecioProducto €</li>
            <li class="list-group-item"><strong>Stock actual:</strong> @Model.StockActual</li>
            <li class="list-group-item"><strong>Proveedor ID:</strong> @Model.IdProveedor</li>
            <li class="list-group-item"><strong>Activo:</strong> @(Model.Activo ? "Sí" : "No")</li>
        </ul>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="IdProducto" />
            <button type="submit" class="btn btn-danger">Eliminar</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
        </form>
    </div>
</div>
