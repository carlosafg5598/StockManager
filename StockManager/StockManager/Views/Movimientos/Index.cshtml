@model IEnumerable<StockManager.Models.MovimientoStock>

@{
    Layout = "_Layout";
}
@if (TempData["ErrorMovimientos"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMovimientos"]
    </div>
}


<h2>Movimientos de Stock</h2>

<a class="btn btn-primary mb-3" asp-action="Create">Registrar nuevo movimiento</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Usuario</th>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Movimiento</th>
            <th>Fecha</th>
            <th>Descripción</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.IdMovimiento</td>
                <td>@(m.Usuario?.NombreCompleto ?? "Sin usuario")</td>
                <td>@(m.Producto?.NombreProducto ?? "Producto eliminado")</td>
                <td>@m.Cantidad</td>
                <td>@m.TipoMovimiento</td>
                <td>@m.FechaMovimiento.ToString("g")</td>
                <td>@m.Descripcion</td>
                <td>
                    <!-- Botones de Editar y Eliminar -->
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@m.IdMovimiento">Editar</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@m.IdMovimiento">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
