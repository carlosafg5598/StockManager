@using Microsoft.AspNetCore.Identity
@inject SignInManager<StockManager.Models.ApplicationUser> SignInManager
@inject UserManager<StockManager.Models.ApplicationUser> UserManager

@{
    var user = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;

    var fuente = user?.FuentePreferida ?? "Arial";
    var tema = user?.TemaColor ?? "claro";
    var fondo = user?.FondoPantalla;
    var fotoPerfil = user?.FotoPerfil ?? "/images/Sto.png";

    // Colores según tema
    var bgColor = tema == "oscuro" ? "#121212" : "#ffffff";
    var textColor = tema == "oscuro" ? "#eaeaea" : "#000000";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StockManager</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StockManager.styles.css" asp-append-version="true" />

    <style>
        body {
            font-family: @(fuente ?? "Arial"), sans-serif !important;
            background-color: @bgColor;
            color: @textColor;
            background-image: url('@fondo');
            background-size: cover;
            background-repeat: no-repeat;
            background-attachment: fixed;
            transition: all 0.3s ease-in-out;
        }

        .navbar, footer {
            background-color: @(tema == "oscuro" ? "#1e1e1e" : "#f8f9fa") !important;
            color: @textColor !important;
        }

            .navbar a, .footer {
                color: @textColor !important;
            }

        .navbar-brand img {
            height: 40px;
            width: 40px;
            object-fit: cover;
            border-radius: 50%;
            border: 2px solid @(tema == "oscuro" ? "#eaeaea" : "#000000");
        }

        /* Botones consistentes con el tema */
        .btn-outline-primary {
            color: @(tema == "oscuro" ? "#eaeaea" : "#0d6efd");
            border-color: @(tema == "oscuro" ? "#eaeaea" : "#0d6efd");
        }

            .btn-outline-primary:hover {
                background-color: @(tema == "oscuro" ? "#eaeaea" : "#0d6efd");
                color: @(tema == "oscuro" ? "#121212" : "#ffffff");
            }

        /* Fondo con opacidad para el contenido */
        .content-wrapper {
            background-color: rgba(255, 255, 255, @(tema == "oscuro" ? "0.05" : "0.8") );
            border-radius: 15px;
            padding: 20px;
            box-shadow: 0 0 15px rgba(0,0,0,0.1);
        }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm border-bottom shadow-sm mb-3">
            <div class="container-fluid">
                <!-- Logo dinámico (foto de perfil o logo por defecto) -->
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <img src="@fotoPerfil" alt="Logo" class="me-2" />
                    <span class="fw-bold">StockManager</span>
                </a>

                <!-- Botón toggler -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (User.IsInRole("Jefe"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Usuarios" asp-action="Index">Usuarios</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Productos" asp-action="Index">Productos</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Proveedores" asp-action="Index">Proveedores</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Movimientos" asp-action="Index">Movimientos</a></li>
                            }
                            else if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Productos" asp-action="Index">Productos</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Proveedores" asp-action="Index">Proveedores</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Movimientos" asp-action="Index">Movimientos</a></li>
                            }
                            else if (User.IsInRole("Empleado"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Movimientos" asp-action="Index">Movimientos</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Productos" asp-action="Index">Ver Stock</a></li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link btn btn-outline-primary me-2" asp-controller="Perfil" asp-action="Edit">Editar perfil</a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Login" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger">Cerrar sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link btn btn-primary" asp-controller="Login" asp-action="Index">Iniciar sesión</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container content-wrapper">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container text-center">
            &copy; 2025 - StockManager
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
